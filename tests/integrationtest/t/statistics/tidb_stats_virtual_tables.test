# TestTiDBStatsVirtualTables
insert into mysql.tidb(variable_name, variable_value, comment) values
    ('tikv_gc_safe_point', '20060102-15:04:05 -0700', 'All versions after safe point can be accessed. (DO NOT EDIT)')
on duplicate key update variable_value = values(variable_value), comment = values(comment);
drop table if exists t;
create table t(a int, b varchar(20), index idx_ab(a, b));
insert into t values (1, 'one'), (1, 'one'), (2, 'two'), (3, null);
analyze table t with 2 buckets, 1 topn;

select table_name, partition_name, row_count, last_analyze_time is not null as analyzed
from information_schema.tidb_stats_meta
where table_schema = database() and table_name = 't';

select count(*) as histogram_count
from information_schema.tidb_stats_histograms
where table_schema = database() and table_name = 't';

select count(*) as unmatched_partition_count
from information_schema.tidb_stats_histograms
where table_schema = database() and table_name = 't' and partition_name = 'missing';

select count(*) > 0 as has_buckets,
       sum(lower_bound is not null and upper_bound is not null) = count(*) as readable_bounds
from information_schema.tidb_stats_buckets
where table_schema = database() and table_name = 't';

select count(*) > 0 as has_topn, sum(value is not null) = count(*) as readable_values
from information_schema.tidb_stats_topn
where table_schema = database() and table_name = 't';

drop table t;
